{
  "manifest_version": 3,
  "name": "Neo Download Manager (NeoDM PRO)",
  "short_name": "NeoDM",
  "version": "1.0.0",
  "description": "High-speed multi-threaded download interception and video grabber for Neo Download Manager PRO (NeoDM).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:19765/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "neodm-extension@neodm.io",
      "strict_min_version": "109.0"
    }
  }
}
