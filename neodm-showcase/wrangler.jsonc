// wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neodm-showcase",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "neodm.techfliq.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "GITHUB_REPO": "aloysiuspattath/neodm"
  }
}
